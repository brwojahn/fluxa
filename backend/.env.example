PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fluxa

# Gere uma chave longa e aleatória para JWT_SECRET antes de usar a API.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Origens permitidas, separadas por vírgula (ex.: Live Server)
FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
